# Postgres connection string — a standalone Postgres you run yourself (NOT Supabase).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/design_firm_ops"

# Optional — only needed if the DATABASE_URL role can't create databases.
# `prisma migrate dev` uses a temporary "shadow database" to detect drift and
# creates it itself, which needs CREATEDB. `npm run setup` grants that, so you
# can normally leave this blank. On a managed Postgres (Supabase/Neon/RDS)
# where CREATEDB isn't grantable, create a second empty database and point this
# at it — otherwise migrations fail with "Error: P3014".
#   SHADOW_DATABASE_URL="postgresql://user:pass@host:5432/design_firm_ops_shadow"
SHADOW_DATABASE_URL=""

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Supabase — file storage ONLY (documents/resources/branding), not the database.
# New-format keys: sb_publishable_... / sb_secret_...
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-me"
SUPABASE_SERVICE_ROLE_KEY="replace-me"
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"

# Resend (transactional email)
RESEND_API_KEY="replace-me"
RESEND_FROM_EMAIL="invoices@designfirmops.app"

# Anthropic (Phase 5 document extraction)
ANTHROPIC_API_KEY="replace-me"

# Encrypts vendor trade-account passwords at rest. Generate with:
#   openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY="replace-with-openssl-rand--base64-32-output"

# Platform operator (SUPER_ADMIN) — seeded at deploy time, never self-serve.
# There is exactly one, it belongs to no firm, and it is the only account that
# can reach /admin. Leave blank to skip seeding it (single-firm dev setups).
# Re-running the seed rotates this password rather than creating a second one.
SEED_SUPER_ADMIN_EMAIL=""
SEED_SUPER_ADMIN_PASSWORD=""

# Seed script accounts (prisma db seed)
SEED_OWNER1_EMAIL="madison@mditerior.com"
SEED_OWNER1_PASSWORD="replace-me"
SEED_OWNER2_EMAIL="owner2@mditerior.com"
SEED_OWNER2_PASSWORD="replace-me"
SEED_DESIGNER_EMAIL="designer@mditerior.com"
SEED_DESIGNER_PASSWORD="replace-me"
