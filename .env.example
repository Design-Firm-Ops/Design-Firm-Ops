# Postgres (Supabase) connection strings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mdi_studio"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mdi_studio"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Supabase Storage (new-format keys: sb_publishable_... / sb_secret_...)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-me"
SUPABASE_SERVICE_ROLE_KEY="replace-me"
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"

# Resend (transactional email)
RESEND_API_KEY="replace-me"

# Anthropic (Phase 5 document extraction)
ANTHROPIC_API_KEY="replace-me"
