// MDI Studio — Prisma schema
// Postgres (Supabase). Money fields always use Decimal, never Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum UserRole {
  ADMIN
  DESIGNER
}

enum ProjectStatus {
  LEAD
  ACTIVE
  ON_HOLD
  COMPLETE
}

enum FeeStructure {
  FLAT_FEE
  HOURLY
  COST_PLUS
  HYBRID
}

enum MarkupMode {
  MARKUP
  MARGIN
}

enum TaxBase {
  MERCH_ONLY
  MERCH_PLUS_SHIPPING
}

enum ItemCategory {
  LIGHTING
  FURNITURE
  PLUMBING
  HARDWARE
  TEXTILES
  ART
  ACCESSORIES
  APPLIANCES
  OTHER
}

enum ItemStatus {
  PROPOSED
  APPROVED
  INVOICED
  ORDERED
  RECEIVED
  DELIVERED
}

enum DocumentType {
  PRESENTATION
  CONTRACT
  VENDOR_INVOICE
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
}

enum PaymentMethod {
  ACH
  WIRE
  CHECK
  CREDIT_CARD
  OTHER
}

/// Which ledger a payment applies to — merchandise invoices or the
/// separate design fee.
enum PaymentCategory {
  MERCHANDISE
  DESIGN_FEE
}

enum VendorAccountType {
  TRADE
  RETAIL
  BOTH
}

enum VendorProductType {
  STOCK
  CUSTOM
  BOTH
}

enum VendorPriceRange {
  LOW
  MID
  HIGH
}

/// FF&E product categories a vendor primarily offers — matches the
/// firm's vendor spreadsheet. Distinct from ItemCategory (line-item
/// categorization), which is coarser.
enum VendorOffering {
  FURNITURE
  OUTDOOR
  RUGS
  PILLOWS
  DECOR
  MIRRORS
  LAMPS
  BEDDING
}

// ---------- Models ----------

/// Internal user (owner or designer). Role gates visibility of
/// sensitive project/vendor data — see Settings' designerCanView* flags.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(DESIGNER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedResources Resource[]
}

model Client {
  id             String    @id @default(cuid())
  name           String
  email          String?
  phone          String?
  billingAddress String?
  notes          String?
  projects       Project[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// Expandable lookup shared by Project and Lead — grows as users type
/// new project types rather than being a fixed enum.
model ProjectType {
  id   String @id @default(cuid())
  name String @unique

  projects Project[]
  leads    Lead[]

  createdAt DateTime @default(now())
}

model Project {
  id             String        @id @default(cuid())
  client         Client        @relation(fields: [clientId], references: [id])
  clientId       String
  name           String
  projectAddress String?
  status         ProjectStatus @default(LEAD)
  startDate      DateTime?

  projectType   ProjectType? @relation(fields: [projectTypeId], references: [id])
  projectTypeId String?

  leadDesignerName String?

  feeStructure FeeStructure @default(COST_PLUS)
  feeNotes     String?

  // Pricing defaults — overridable per line item.
  defaultMarkupPct Decimal    @default(15) @db.Decimal(6, 3)
  markupMode       MarkupMode @default(MARKUP)

  // Tax config. salesTaxRate is a fraction (0.07 = 7%).
  salesTaxRate Decimal @default(0) @db.Decimal(6, 4)
  taxBase      TaxBase @default(MERCH_ONLY)

  // Used to derive invoice numbers, e.g. "2506" -> 2506-001, 2506-002...
  invoicePrefix String?

  items             Item[]
  documents         Document[]
  invoices          Invoice[]
  payments          Payment[]
  designFeeCharges  DesignFeeCharge[]
  convertedFromLead Lead?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A single billed-toward-the-design-fee line entry. Separate from
/// merchandise Invoices — design fees are billed on their own ledger.
model DesignFeeCharge {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model Vendor {
  id      String  @id @default(cuid())
  name    String
  website String?

  // Rep contact — the person to call/email at this vendor.
  repName  String?
  repEmail String?
  repPhone String?

  // Showroom — where the vendor's account/rep is physically based.
  showroomName    String?
  showroomAddress String?

  accountType VendorAccountType?
  productType VendorProductType?
  priceRange  VendorPriceRange?
  offerings   VendorOffering[]

  notes         String?
  accountNumber String?

  // Trade account credentials — permission-gated (Settings.designerCanViewVendorCredentials).
  // Password is encrypted at rest (see lib/crypto.ts); notes covers
  // non-standard cases ("no login, quotes through rep", "application pending").
  tradeAccountUsername          String?
  tradeAccountPasswordEncrypted String?
  tradeAccountNotes             String?

  items Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A single merchandise line item within a project.
model Item {
  id                 String       @id @default(cuid())
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          String
  tag                String
  name               String
  invoiceDisplayName String?
  category           ItemCategory @default(OTHER)
  room               String?

  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  vendorId String?

  qty         Int     @default(1)
  unitCost    Decimal @db.Decimal(10, 2)
  platformFee Decimal @default(0) @db.Decimal(10, 2)

  // Nullable overrides — fall back to the project's defaults when null.
  markupPct  Decimal?    @db.Decimal(6, 3)
  markupMode MarkupMode?

  dimensions    String?
  finish        String?
  link          String?
  shippingNotes String?

  status ItemStatus @default(PROPOSED)

  sourceDocument   Document? @relation(fields: [sourceDocumentId], references: [id])
  sourceDocumentId String?

  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Document {
  id          String       @id @default(cuid())
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  type        DocumentType
  filename    String
  // Object path within the private "documents" bucket — never a public
  // URL. Access is always through a short-lived signed URL minted on
  // request (see lib/supabase.ts).
  storagePath String
  uploadedAt  DateTime     @default(now())

  sourcedItems Item[]

  @@index([projectId])
}

/// A generated merchandise invoice. Shipping/tax are snapshotted at
/// creation time so historical invoices never change if project
/// defaults change later.
model Invoice {
  id            String        @id @default(cuid())
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)

  shippingTotal Decimal @default(0) @db.Decimal(10, 2)
  taxRate       Decimal @db.Decimal(6, 4)
  taxBase       TaxBase

  issuedDate DateTime?
  dueDate    DateTime?
  notes      String?

  items    Item[]
  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Payment {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId String?

  category  PaymentCategory @default(MERCHANDISE)
  amount    Decimal         @db.Decimal(10, 2)
  date      DateTime        @default(now())
  method    PaymentMethod   @default(OTHER)
  reference String?
  notes     String?

  createdAt DateTime @default(now())

  @@index([projectId])
}

/// A pipeline column on the Business Development kanban board — fully
/// customizable (add/rename/reorder/delete) by users.
model PipelineStage {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReferralPartner {
  id           String  @id @default(cuid())
  name         String
  businessName String?
  contactEmail String?
  contactPhone String?
  notes        String?

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A prospective client tracked through the sales pipeline. Converts
/// into a real Client + Project once won.
model Lead {
  id         String @id @default(cuid())
  clientName String

  projectType   ProjectType? @relation(fields: [projectTypeId], references: [id])
  projectTypeId String?

  referralSource String?

  referralPartner   ReferralPartner? @relation(fields: [referralPartnerId], references: [id])
  referralPartnerId String?

  contactEmail String?
  contactPhone String?
  address      String?
  notes        String?

  squareFootage    Int?
  estimatedBudget  Decimal? @db.Decimal(12, 2)
  timeline         String?
  builderName      String?
  architectName    String?

  pipelineStage   PipelineStage @relation(fields: [pipelineStageId], references: [id])
  pipelineStageId String
  sortOrder       Int           @default(0)

  // Set once this lead is converted — the lead stays in the CRM as a
  // record but is flagged as won.
  convertedProject   Project? @relation(fields: [convertedProjectId], references: [id])
  convertedProjectId String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipelineStageId])
}

/// A firm-wide file in the Administration storage center — templates,
/// marketing materials, resources. Not tied to any single project.
/// "Folder" is free text so the library stays user-customizable
/// without a rigid taxonomy.
model Resource {
  id          String   @id @default(cuid())
  folder      String
  filename    String
  storagePath String
  uploadedAt  DateTime @default(now())

  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])
  uploadedById String?
}

/// Singleton company settings row (id is always 1).
model Settings {
  id Int @id @default(1)

  companyName    String
  companyAddress String?

  owner1Name    String?
  owner1Contact String?
  owner2Name    String?
  owner2Contact String?

  // Rich text (HTML) — ACH / wire / Chase Bill Pay instructions rendered on invoice PDFs.
  paymentInstructions String?

  logoUrl String?

  // Designer-role visibility toggles. ADMIN always sees everything;
  // these gate what DESIGNER-role users see. Configured on the
  // Administration > Permissions tab.
  designerCanViewFinancials             Boolean @default(false)
  designerCanViewClientContact          Boolean @default(true)
  designerCanViewDocumentsPresentations Boolean @default(true)
  designerCanViewContracts              Boolean @default(true)
  designerCanViewInvoices               Boolean @default(true)
  designerCanViewProcurement            Boolean @default(true)
  designerCanViewVendorCredentials      Boolean @default(false)

  updatedAt DateTime @updatedAt
}
