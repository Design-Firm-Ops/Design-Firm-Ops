// Design Firm Ops — Prisma schema
// Postgres. Money fields always use Decimal, never Float.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // Optional. `prisma migrate dev` needs a scratch "shadow database" to detect
  // drift; by default it creates one itself, which requires CREATEDB on the
  // connecting role. Where that can't be granted (most managed Postgres), point
  // this at a second database you created by hand. Leaving SHADOW_DATABASE_URL
  // unset or empty falls back to the default behaviour. See .env.example.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ---------- Enums ----------

/// Lifecycle of a tenant. Suspending or cancelling a firm is a status flip,
/// never data deletion — the records survive so the state stays reversible and
/// auditable (plans/ADMIN_DASHBOARD.md §5).
enum FirmStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELED
}

/// ADMIN and DESIGNER are roles *within* a firm. SUPER_ADMIN is a platform
/// operator who belongs to no firm (`User.firmId` is null) — there is exactly
/// one, seeded at deploy time and never mintable through the UI. A partial
/// unique index enforces that; see the DES-24 migration for why it can't be
/// expressed here (plans/ADMIN_DASHBOARD.md §3.3).
enum UserRole {
  ADMIN
  DESIGNER
  SUPER_ADMIN
}

enum ProjectStatus {
  LEAD
  ACTIVE
  ON_HOLD
  COMPLETE
}

/// Which kind of fee a FeeStructureOption describes — a project's
/// design fee arrangement (Fixed Fee, Hourly, ...) and its procurement
/// arrangement (Cost Plus, Fixed Fee, Hourly, ...) are separate,
/// independently customizable lists.
enum FeeStructureScope {
  DESIGN_FEE
  PROCUREMENT
}

enum MarkupMode {
  MARKUP
  MARGIN
}

enum TaxBase {
  MERCH_ONLY
  MERCH_PLUS_SHIPPING
}

enum DimensionUnit {
  IN
  CM
}

enum ItemStatus {
  PROPOSED
  APPROVED
  INVOICED
  ORDERED
  RECEIVED
  DELIVERED
}

enum DocumentType {
  PRESENTATION
  CONTRACT
  VENDOR_INVOICE
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

/// A Procurement Invoice bills merchandise line Items; a Design Fee
/// Invoice bills DesignFeeCharge rows instead. Two independent
/// numbering/locking sets on the same Invoice model rather than two
/// tables, so both share status/send/void/PDF machinery.
enum InvoiceType {
  PROCUREMENT
  DESIGN_FEE
}

enum PaymentMethod {
  ACH
  WIRE
  CHECK
  CREDIT_CARD
  OTHER
}

/// Which ledger a payment applies to — merchandise invoices or the
/// separate design fee.
enum PaymentCategory {
  MERCHANDISE
  DESIGN_FEE
}

enum VendorAccountType {
  TRADE
  RETAIL
  BOTH
}

enum VendorProductType {
  STOCK
  CUSTOM
  BOTH
}

enum VendorPriceRange {
  LOW
  MID
  HIGH
}

/// Input type for a user-defined ProjectFieldDef / ItemFieldDef. Values
/// are always stored as text — this only hints at how to render/parse
/// the input.
enum FieldType {
  TEXT
  NUMBER
  DATE
  CURRENCY
  RICH_TEXT
}

// ---------- Models ----------

/// A user-customizable product category tagged on Vendor.offerings —
/// labels are entirely up to the firm (seeded with the original FF&E
/// spreadsheet categories, but freely renamable).
/// The tenant root. Every firm-owned record traces back to a Firm, either by
/// its own `firmId` or through its parent (plans/ADMIN_DASHBOARD.md §3.2).
model Firm {
  id     String     @id @default(cuid())
  name   String
  /// URL-safe handle. Used in /admin console URLs today, and the hook for
  /// subdomain routing if that ever lands.
  slug   String     @unique
  status FirmStatus @default(TRIAL)
  /// Free-form tier for now (BASIC/PRO/…); real plan limits are deferred.
  plan   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  clients             Client[]
  projects            Project[]
  vendors             Vendor[]
  offerings           Offering[]
  projectTypes        ProjectType[]
  itemTypeOptions     ItemTypeOption[]
  feeStructureOptions FeeStructureOption[]
  resourceFolders     ResourceFolder[]
  resources           Resource[]
  leadBoards          LeadBoard[]
  referralPartners    ReferralPartner[]
  settings            Settings?

  // Denormalized onto the money tables for cheap isolation checks (§6 Q2).
  invoices Invoice[]
  items    Item[]
  payments Payment[]
}

model Offering {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId String

  vendors Vendor[]

  createdAt DateTime @default(now())

  @@unique([firmId, name])
  @@index([firmId])
}

/// A user-customizable line-item sub-type scoped to a category (e.g.
/// "Sconce" under "Lighting") — tagPrefix drives auto-generated tags
/// (the first Sconce added to a project becomes "SC-1"), see
/// lib/itemType.ts / lib/itemTag.ts. Global across the firm, same
/// growable pattern as Offering.
model ItemTypeOption {
  id        String @id @default(cuid())
  category  String
  name      String
  tagPrefix String
  order     Int    @default(0)

  items Item[]

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId String

  createdAt DateTime @default(now())

  @@unique([firmId, category, name])
  @@index([firmId])
}

/// A user-customizable label for how a project's design fee or its
/// procurement work is commercially structured (Fixed Fee / Hourly /
/// Cost Plus / anything custom a user types). Purely descriptive —
/// separate from the markup/tax fields that actually drive pricing.
/// Same growable-list pattern as Offering and ProjectType, scoped so
/// the design-fee list and procurement list never mix.
model FeeStructureOption {
  id    String            @id @default(cuid())
  name  String
  scope FeeStructureScope
  order Int               @default(0)

  designFeeProjects      Project[] @relation("ProjectDesignFeeStructure")
  procurementFeeProjects Project[] @relation("ProjectProcurementFeeStructure")

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId String

  createdAt DateTime @default(now())

  @@unique([firmId, scope, name])
  @@index([firmId])
}

/// Internal user (owner or designer). Role gates visibility of
/// sensitive project/vendor data — see Settings' designerCanView* flags.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(DESIGNER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Null for a platform operator (SUPER_ADMIN), who belongs to no firm.
  /// Email stays globally unique so credentials login can identify a user
  /// without a firm in hand — see plans/DES-23_PLAN.md Finding 2.
  firm   Firm?   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId String?

  uploadedResources  Resource[]
  permissionOverride UserPermissionOverride?

  @@index([firmId])
}

/// Per-user permission overrides. Null on any field means "inherit the
/// Designer role default" (Settings.designerCanView*); true/false pins
/// that permission for this one person regardless of the role default —
/// e.g. one designer can see pricing while another can't. ADMIN-role
/// users never consult this table; they always see everything.
model UserPermissionOverride {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  financials             Boolean?
  clientContact          Boolean?
  documentsPresentations Boolean?
  contracts              Boolean?
  invoices               Boolean?
  procurement            Boolean?
  vendorCredentials      Boolean?

  updatedAt DateTime @updatedAt
}

model Client {
  id             String          @id @default(cuid())
  name           String
  // Primary contact — used wherever exactly one email/phone is needed
  // (e.g. invoice sending). Additional points of contact live in
  // ClientContact below.
  contactName    String?
  email          String?
  phone          String?
  billingAddress String?
  notes          String?
  contacts       ClientContact[]
  projects       Project[]

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId])
}

/// An additional point of contact for a client beyond the primary
/// name/email/phone on Client itself — a project may have more than
/// one person to reach (e.g. a property manager alongside the owner).
model ClientContact {
  id       String  @id @default(cuid())
  client   Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String
  name     String?
  email    String?
  phone    String?
  order    Int     @default(0)

  createdAt DateTime @default(now())

  @@index([clientId])
}

/// Expandable lookup shared by Project and Lead — grows as users type
/// new project types rather than being a fixed enum.
model ProjectType {
  id   String @id @default(cuid())
  name String

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId String

  projects Project[]
  leads    Lead[]

  createdAt DateTime @default(now())

  @@unique([firmId, name])
  @@index([firmId])
}

model Project {
  id             String        @id @default(cuid())
  client         Client        @relation(fields: [clientId], references: [id])
  clientId       String
  name           String
  projectAddress String?
  status         ProjectStatus @default(LEAD)
  startDate      DateTime?

  projectType   ProjectType? @relation(fields: [projectTypeId], references: [id])
  projectTypeId String?

  leadDesignerName String?

  designFeeStructure   FeeStructureOption? @relation("ProjectDesignFeeStructure", fields: [designFeeStructureId], references: [id], onDelete: SetNull)
  designFeeStructureId String?
  feeNotes             String?

  // Shown at the top of the Procurement tab — purely descriptive, same
  // pattern as designFeeStructure above.
  procurementFeeStructure   FeeStructureOption? @relation("ProjectProcurementFeeStructure", fields: [procurementFeeStructureId], references: [id], onDelete: SetNull)
  procurementFeeStructureId String?

  // Pricing defaults — overridable per line item.
  defaultMarkupPct Decimal    @default(15) @db.Decimal(6, 3)
  markupMode       MarkupMode @default(MARKUP)

  // Tax config. salesTaxRate is a fraction (0.07 = 7%).
  salesTaxRate Decimal @default(0) @db.Decimal(6, 4)
  taxBase      TaxBase @default(MERCH_ONLY)

  // Used to derive invoice numbers, e.g. "2506" -> 2506-001, 2506-002...
  invoicePrefix String?

  // Which invoice columns new invoices on this project start with — see
  // Invoice.columnConfig. Null = fall back to the built-in "transparent" preset.
  defaultInvoiceColumnConfig Json?

  items             Item[]
  procurementLists  ProcurementList[]
  documentFolders   ProjectDocumentFolder[]
  rooms             ProjectRoom[]
  documents         Document[]
  invoices          Invoice[]
  payments          Payment[]
  designFeeCharges  DesignFeeCharge[]
  convertedFromLead Lead?
  fieldValues       ProjectFieldValue[]

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId])
}

/// A user-defined field shown on every project's overview — admin
/// manages the set, order, and per-field Designer visibility; the
/// actual per-project text lives in ProjectFieldValue. Intended as the
/// landing spot for future AI-extracted contract data (e.g. Design Fee).
model ProjectFieldDef {
  id                String    @id @default(cuid())
  label             String
  fieldType         FieldType @default(TEXT)
  order             Int       @default(0)
  visibleToDesigner Boolean   @default(true)

  values ProjectFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProjectFieldValue {
  id         String          @id @default(cuid())
  project    Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  fieldDef   ProjectFieldDef @relation(fields: [fieldDefId], references: [id], onDelete: Cascade)
  fieldDefId String
  value      String?

  updatedAt DateTime @updatedAt

  @@unique([projectId, fieldDefId])
}

/// Same pattern as ProjectFieldDef, scoped to line items instead —
/// intended as the landing spot for future AI-extracted vendor PDF data.
model ItemFieldDef {
  id                String    @id @default(cuid())
  label             String
  fieldType         FieldType @default(TEXT)
  order             Int       @default(0)
  visibleToDesigner Boolean   @default(true)

  values ItemFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ItemFieldValue {
  id         String       @id @default(cuid())
  item       Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId     String
  fieldDef   ItemFieldDef @relation(fields: [fieldDefId], references: [id], onDelete: Cascade)
  fieldDefId String
  value      String?

  updatedAt DateTime @updatedAt

  @@unique([itemId, fieldDefId])
}

/// A single billed-toward-the-design-fee line entry. Separate from
/// merchandise Invoices — design fees are billed on their own ledger.
/// A single billed-toward-the-design-fee line entry. Locked (cannot be
/// edited or deleted) the moment it's attached to a Design Fee Invoice —
/// same invoiceId-presence-is-the-lock pattern as Item, see lib/itemLock.ts.
model DesignFeeCharge {
  id          String   @id @default(cuid())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId String?

  @@index([projectId])
  @@index([invoiceId])
}

model Vendor {
  id      String  @id @default(cuid())
  name    String
  website String?

  // Rep contact — the person to call/email at this vendor.
  repName  String?
  repEmail String?
  repPhone String?

  // Showroom — where the vendor's account/rep is physically based.
  showroomName    String?
  showroomAddress String?

  accountType VendorAccountType?
  productType VendorProductType?
  priceRange  VendorPriceRange?
  offerings   Offering[]

  notes         String?
  accountNumber String?

  // Trade account credentials — permission-gated (Settings.designerCanViewVendorCredentials).
  // Password is encrypted at rest (see lib/crypto.ts); notes covers
  // non-standard cases ("no login, quotes through rep", "application pending").
  tradeAccountUsername          String?
  tradeAccountPasswordEncrypted String?
  tradeAccountNotes             String?

  items Item[]

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId])
}

/// A single merchandise line item within a project.
model Item {
  id                 String  @id @default(cuid())
  project            Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId          String
  tag                String
  name               String
  invoiceDisplayName String?
  // Free text, deliberately not an enum — matches this project's
  // Procurement tab list names 1:1 (see ProcurementList), so a new
  // item's category defaults to whichever list it's added into.
  category           String  @default("Other Merchandise")
  room               String?

  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  vendorId String?

  // A user-customizable sub-type scoped to a category (e.g. "Sconce"
  // under "Lighting") — its tagPrefix drives auto-generated tags, see
  // lib/itemType.ts / lib/itemTag.ts.
  itemType   ItemTypeOption? @relation(fields: [itemTypeId], references: [id], onDelete: SetNull)
  itemTypeId String?

  procurementList   ProcurementList? @relation(fields: [procurementListId], references: [id])
  procurementListId String?

  qty         Int     @default(1)
  unitCost    Decimal @db.Decimal(10, 2)
  platformFee Decimal @default(0) @db.Decimal(10, 2)

  // Nullable overrides — fall back to the project's defaults when null.
  markupPct  Decimal?    @db.Decimal(6, 3)
  markupMode MarkupMode?

  // Structured H x W x L — legacyDimensionsNote preserves whatever
  // freeform text lived in the old single "dimensions" field.
  dimensionHeight      Decimal?      @db.Decimal(8, 2)
  dimensionWidth       Decimal?      @db.Decimal(8, 2)
  dimensionLength      Decimal?      @db.Decimal(8, 2)
  dimensionUnit        DimensionUnit @default(IN)
  legacyDimensionsNote String?
  weight               Decimal?      @db.Decimal(8, 2)

  // Lighting-only fields — shown in the UI when category is "Lighting".
  // bulbIncluded is deliberately tri-state: null means not yet reviewed,
  // so the Bulbs summary (derived, see ItemsTable.tsx) only ever picks
  // up items someone has explicitly marked "No".
  bulbSpec     String?
  bulbQty      Int?
  bulbIncluded Boolean?

  finish        String?
  link          String?
  shippingNotes String?

  // Path in the private "documents" bucket for a thumbnail image —
  // signed URL minted on request, same as project documents.
  imageStoragePath String?

  status ItemStatus @default(PROPOSED)

  sourceDocument   Document? @relation(fields: [sourceDocumentId], references: [id])
  sourceDocumentId String?

  // Quotes, spec sheets, etc. attached directly to this item — distinct
  // from sourceDocument, which is the presentation/doc this item was
  // originally pulled from.
  attachedDocuments Document[] @relation("ItemAttachedDocuments")

  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId String?

  fieldValues ItemFieldValue[]

  sortOrder Int @default(0)

  // Denormalized from the parent project for cheap isolation checks on the
  // money tables (plans/ADMIN_DASHBOARD.md §6 Q2). Must always match
  // project.firmId.
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([procurementListId])
  @@index([itemTypeId])
  @@index([firmId])
}

/// A user-defined sub-list within a project's Procurement tab (e.g.
/// "Lighting", "Furniture") — lets the firm organize line items into
/// as many working lists as a project needs.
model ProcurementList {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  name      String
  order     Int     @default(0)

  items Item[]

  createdAt DateTime @default(now())

  @@index([projectId])
}

/// A named folder shown in a project's Project Documents tab — same
/// rename/reorder pattern as ProcurementList. Document.folder stores
/// the folder's current name as free text (not a FK), so renaming here
/// must cascade to every Document row tagged with the old name — see
/// PATCH /api/document-folders/[id].
model ProjectDocumentFolder {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  name      String
  order     Int     @default(0)

  createdAt DateTime @default(now())

  @@index([projectId])
}

/// A project-scoped, growable list of room-name suggestions — Item.room
/// stays plain text (not a FK), this table just backs the dropdown so
/// re-typing "Living Room" twice can't drift into a typo. Same
/// find-or-create pattern as ProjectType, but scoped per project since
/// a project's rooms are specific to its own floor plan.
model ProjectRoom {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String
  name      String
  order     Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([projectId, name])
}

model Document {
  id          String       @id @default(cuid())
  // Exactly one of project/lead is set for top-level uploads; a
  // conversion (Lead -> Project) simply re-points existing rows rather
  // than copying files. itemId additionally tags a document as
  // attached to one specific line item (quotes, spec sheets).
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String?
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String?
  item        Item?        @relation("ItemAttachedDocuments", fields: [itemId], references: [id], onDelete: Cascade)
  itemId      String?
  type        DocumentType
  // User-organized folder within the project's Documents and
  // Presentations tab (e.g. "Precedent Images"). Null for
  // Contract-type documents and lead/item attachments, which aren't
  // folder-organized.
  folder      String?
  filename    String
  // Object path within the private "documents" bucket — never a public
  // URL. Access is always through a short-lived signed URL minted on
  // request (see lib/supabase.ts).
  storagePath String
  uploadedAt  DateTime     @default(now())

  sourcedItems Item[]

  @@index([projectId])
  @@index([leadId])
  @@index([itemId])
}

/// A generated merchandise invoice. Shipping/tax are snapshotted at
/// creation time so historical invoices never change if project
/// defaults change later.
model Invoice {
  id            String        @id @default(cuid())
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId     String
  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)
  type          InvoiceType   @default(PROCUREMENT)

  shippingTotal Decimal @default(0) @db.Decimal(10, 2)
  taxRate       Decimal @db.Decimal(6, 4)
  taxBase       TaxBase

  issuedDate DateTime?
  dueDate    DateTime?
  notes      String?

  // Generated on first Send — permanent, unique link for the (Phase 4)
  // client payment portal. Exists now so send/PDF links are already
  // correct once the portal page itself ships.
  portalToken String? @unique

  // Which columns this invoice's PDF/portal render show the client —
  // see lib/invoiceColumns.ts for the shape and presets. Null = use the
  // project's defaultInvoiceColumnConfig (or the built-in preset if
  // that's also null).
  columnConfig Json?

  items            Item[]
  designFeeCharges DesignFeeCharge[]
  payments         Payment[]

  // Denormalized from the parent project for cheap isolation checks on the
  // money tables (plans/ADMIN_DASHBOARD.md §6 Q2). Must always match
  // project.firmId.
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([firmId, invoiceNumber])
  @@index([projectId])
  @@index([firmId])
}

model Payment {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId String?

  category  PaymentCategory @default(MERCHANDISE)
  amount    Decimal         @db.Decimal(10, 2)
  date      DateTime        @default(now())
  method    PaymentMethod   @default(OTHER)
  reference String?
  notes     String?

  // Denormalized from the parent project for cheap isolation checks on the
  // money tables (plans/ADMIN_DASHBOARD.md §6 Q2). Must always match
  // project.firmId.
  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId String

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([firmId])
}

/// One of up to 5 independent lead pipelines (e.g. "Residential",
/// "Commercial") — each behaves like its own kanban board with its own
/// columns.
model LeadBoard {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  stages PipelineStage[]

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId])
}

/// A pipeline column on a Business Development kanban board — fully
/// customizable (add/rename/reorder/delete) by users.
model PipelineStage {
  id      String    @id @default(cuid())
  board   LeadBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId String
  name    String
  order   Int       @default(0)

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}

model ReferralPartner {
  id           String  @id @default(cuid())
  name         String
  businessName String?
  contactEmail String?
  contactPhone String?
  notes        String?

  leads Lead[]

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([firmId])
}

/// A prospective client tracked through the sales pipeline. Converts
/// into a real Client + Project once won.
model Lead {
  id         String @id @default(cuid())
  clientName String

  projectType   ProjectType? @relation(fields: [projectTypeId], references: [id])
  projectTypeId String?

  referralSource String?

  referralPartner   ReferralPartner? @relation(fields: [referralPartnerId], references: [id])
  referralPartnerId String?

  contactEmail String?
  contactPhone String?
  address      String?
  notes        String?

  squareFootage   Int?
  estimatedBudget Decimal? @db.Decimal(12, 2)
  timeline        String?
  builderName     String?
  architectName   String?

  pipelineStage   PipelineStage @relation(fields: [pipelineStageId], references: [id])
  pipelineStageId String
  sortOrder       Int           @default(0)

  // Set once this lead is converted — the lead stays in the CRM as a
  // record but is flagged as won.
  convertedProject   Project? @relation(fields: [convertedProjectId], references: [id])
  convertedProjectId String?  @unique

  documents Document[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pipelineStageId])
}

/// A firm-wide file in the Administration storage center — templates,
/// marketing materials, resources. Not tied to any single project.
/// "Folder" is free text so the library stays user-customizable
/// without a rigid taxonomy.
model Resource {
  id          String   @id @default(cuid())
  folder      String
  filename    String
  storagePath String
  uploadedAt  DateTime @default(now())

  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])
  uploadedById String?

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId String

  @@index([firmId])
}

/// Access-control metadata for a Storage Center folder, keyed by
/// folder name (Resource.folder is free text, so this row is optional
/// and only appears once someone restricts a folder). Admins always
/// have access regardless of this list; an empty list means everyone
/// with Administration access can see the folder.
model ResourceFolder {
  id             String   @id @default(cuid())
  name           String
  allowedUserIds String[] @default([])

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([firmId, name])
  @@index([firmId])
}

/// Singleton company settings row (id is always 1).
/// Per-firm settings. Was a hard singleton (`id Int @default(1)`) when the app
/// served one firm; now exactly one row per Firm, keyed by a unique firmId.
model Settings {
  id String @id @default(cuid())

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  firmId String @unique

  companyName    String
  companyAddress String?

  owner1Name    String?
  owner1Contact String?
  owner2Name    String?
  owner2Contact String?

  // Rich text (HTML) — ACH / wire / Chase Bill Pay instructions rendered on invoice PDFs.
  paymentInstructions String?

  logoUrl String?

  // Invoice PDF/email branding — defaults to the Design Firm Ops brand
  // colors (see globals.css) when unset; admin can override per firm.
  invoicePrimaryColor String?
  invoiceAccentColor  String?

  // Designer-role visibility toggles. ADMIN always sees everything;
  // these gate what DESIGNER-role users see. Configured on the
  // Administration > Permissions tab.
  designerCanViewFinancials             Boolean @default(false)
  designerCanViewClientContact          Boolean @default(true)
  designerCanViewDocumentsPresentations Boolean @default(true)
  designerCanViewContracts              Boolean @default(true)
  designerCanViewInvoices               Boolean @default(true)
  designerCanViewProcurement            Boolean @default(true)
  designerCanViewVendorCredentials      Boolean @default(false)

  updatedAt DateTime @updatedAt
}
